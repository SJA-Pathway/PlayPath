{
  "name": "nexus-sentient-galaxy",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "NEXUS: The Sentient Galaxy — browser space RPG (Three.js + TypeScript + Cloudflare Workers)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dev": "npm run build && wrangler deploy --env dev"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@cloudflare/workers-types": "^4.20250920.0",
    "@types/three": "0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "wrangler": "4.65.0"
  },
  "engines": {
    "node": ">=22"
  }
}
